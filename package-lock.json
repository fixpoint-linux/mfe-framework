{
  "name": "mfe-framework",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "mfe-framework",
      "version": "0.1.0",
      "workspaces": [
        "packages/*",
        "examples/*"
      ]
    },
    "examples/demo": {
      "version": "0.1.0",
      "dependencies": {
        "@mfe/core": "*",
        "@mfe/framework": "*"
      }
    },
    "node_modules/@mfe/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/@mfe/framework": {
      "resolved": "packages/framework",
      "link": true
    },
    "node_modules/demo": {
      "resolved": "examples/demo",
      "link": true
    },
    "packages/core": {
      "name": "@mfe/core",
      "version": "0.1.0"
    },
    "packages/framework": {
      "name": "@mfe/framework",
      "version": "0.1.0",
      "dependencies": {
        "@mfe/core": "*"
      }
    }
  }
}
